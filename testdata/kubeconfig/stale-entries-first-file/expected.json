      "namespace": "team-a",
      "auth": { "kind": "token", "token": "fake-token-1" }
    },
    {
      "name": "team-a-aks",
      "cluster": "team-a-aks",
      "server": "https://team-a-aks-dns-7d81a0c3.hcp.westeurope.example.com:443",
      "user": "clusterUser_rg-team-a_team-a-aks",
      "namespace": "default",
      "auth": {
        "kind": "exec",
        "command": "kubelogin",
        "args": [
          "get-token",
          "--login",
          "azurecli",
          "--server-id",
          "00000000-0000-0000-0000-00000000aa01"
        ]
      }
    }
  ],
  "sources": [
    {
      "file": "01-config.yaml",
